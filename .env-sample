
# Local dev: http://localhost:8080/api/v1
# Production (Vercel): leave unset (defaults to /api/v1, proxied to Render by vercel.json) or set
# to /api/v1. Do NOT point it at the Render URL: auth uses httpOnly cookies, which browsers block
# on cross-site requests.
VITE_BACKEND_URL=

# Optional: Development settings
VITE_NODE_ENV=development
VITE_DEBUG=true